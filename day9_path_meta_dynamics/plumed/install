rm -r bin/ include/ lib/ plumed-2.3.8
tar xvf plumed-2.3.8.tgz 
cp MetaD.cpp plumed-2.3.8/src/bias/
cp LatticeReduction.cpp plumed-2.3.8/src/tools/
cp PathCV.cpp plumed-2.3.8/src/function/
cp PES.cpp plumed-2.3.8/src/cltools/
root=$(pwd)
cd plumed-2.3.8
./configure --prefix="$root"
make -j 8
make install
make doc
source sourceme.sh
